<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necessaria para falar com as termicas na porta 9100 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Apps da maquininha Cielo Smart que atendem lio://payment (o segundo
         pacote foi achado por quem ja integrou; declarados os dois) -->
    <queries>
        <package android:name="com.ads.lio.uriappclient" />
        <package android:name="br.com.cielosmart.orderservice" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.MadeInBrazilPDV">
        <!-- a Cielo exige este metadado para distribuir nos terminais: "uri" = integracao por Deep Link -->
        <meta-data
            android:name="cs_integration_type"
            android:value="uri" />
        <!-- singleTask: a resposta da Cielo cai nesta mesma tela (onNewIntent) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MadeInBrazilPDV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Resposta da maquininha: mibpdv://pagamento?response=<BASE64(JSON)> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mibpdv" android:host="pagamento" />
            </intent-filter>
        </activity>
    </application>
</manifest>
